# Every variable is optional; the defaults are in src/evilflowers_text/settings.py.

REDIS_URL=redis://redis:6379/7
TEXT_QUEUE=evilflowers_text_worker
EMBED_QUEUE=evilflowers_text_embed
# Seconds before Redis redelivers an unacknowledged extraction job; longer than the longest book.
BROKER_VISIBILITY_TIMEOUT=7200
STORAGE_PATH=/mnt/data

# IP-018 extraction jobs report here, with the API key of a user holding `extraction.ingest_extraction`.
CATALOG_API_URL=http://catalog:8000
CATALOG_API_KEY=

# Paragraph index (IP-018 Phase 2b). Changing the model bumps the catalog's pipeline version.
EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-m-v2.0
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
MIN_PARAGRAPH_WORDS=10
SIMILAR_LINKS_K=5
SIMILAR_MIN_SCORE=0.6
HF_HOME=/models

# Table crops
CROP_DPI=144
WEBP_QUALITY=82

# search-service indexing (`process_pdf`)
SEARCH_SERVICE_URL=http://search-service:8001
CHUNK_SIZE=768
CHUNK_OVERLAP=50
TABLE_EXTRACTOR=PdfPlumber
# YOLO_MODEL_PATH=/models/doclayout_yolo_doclaynet_imgsz1120_docsynth_pretrain.pt

# Logs: json (one object per line with level, trace_id and run_id/entry_id; what Loki parses) or text
LOG_FORMAT=json

# Telemetry. Off when neither an OTLP endpoint nor HOST_IP is set.
# In k8s the pod sets HOST_IP + OTEL_* (knowledge base: Cookbooks/Deploy-a-Service §3).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://<alloy>:4318
# OTEL_SERVICE_NAME=text
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=elvira,deployment.environment.name=development
