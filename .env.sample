# Every variable is optional; the defaults are in src/evilflowers_text/settings.py.

REDIS_URL=redis://redis:6379/7
TEXT_QUEUE=evilflowers_text_worker
# Seconds before Redis redelivers an unacknowledged extraction job; longer than the longest book.
BROKER_VISIBILITY_TIMEOUT=7200
STORAGE_PATH=/mnt/data

# IP-018 extraction jobs report here, with the API key of a user holding `extraction.ingest_extraction`.
CATALOG_API_URL=http://catalog:8000
CATALOG_API_KEY=

# Paragraph embeddings: the shared tei-embed (multilingual-e5-large-instruct, 1024 dims).
# In k8s: http://tei-embed.shared.svc.cluster.local (the default), no TEI_HOST.
# Compose on gateway: TEI_URL=http://192.168.122.227:8081 and TEI_HOST=embed.elvira.internal (Known-Issues #7).
# Laptop on the VPN: TEI_URL=http://tei-embed.shared.stu.k8s.internal
TEI_URL=http://tei-embed.shared.svc.cluster.local
# 1Password ELVIRA/stu.inference.tei/api_key
TEI_API_KEY=
# TEI_HOST=embed.elvira.internal
TEI_BATCH_SIZE=32
TEI_TIMEOUT=60
TEI_ATTEMPTS=4

# Paragraph index (IP-018 Phase 2b)
MIN_PARAGRAPH_WORDS=10
SIMILAR_LINKS_K=5
SIMILAR_MIN_SCORE=0.6

# Table crops
CROP_DPI=144
WEBP_QUALITY=82

# Logs: json (one object per line with level, trace_id and run_id; what Loki parses) or text
LOG_FORMAT=json

# Telemetry. Off when neither an OTLP endpoint nor HOST_IP is set.
# In k8s the pod sets HOST_IP + OTEL_* (knowledge base: Cookbooks/Deploy-a-Service §3).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://<alloy>:4318
# OTEL_SERVICE_NAME=text
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=elvira,deployment.environment.name=development

# CPU profiling (Pyroscope SDK, Python frames). Off unless PYROSCOPE_SERVER_ADDRESS is set.
# In k8s the knowledge repo sets these for instances listed in evilflowers_instances.<env>.pyroscope_sdk.
# PYROSCOPE_SERVER_ADDRESS=http://<pyroscope>:4040
# PYROSCOPE_APPLICATION_NAME=text
# PYROSCOPE_TAGS=namespace=evilflowers-dev,pod=<pod>,container=text,cluster=k8s-stu
